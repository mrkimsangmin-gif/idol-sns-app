  "members": [
    {
      "name": "김진환",
      "본명": "김진환",
      "출생연도": "1994",
      "생년월일": "1994.02.07",
      "출신지": "",
      "역할": "메인보컬, 리드댄서",
      "키": "",
      "MBTI": "ISFP",
      "혈액형": "A",
      "info": "특유의 간질거리는 목소리가 특징이며 끝음 처리가 깔끔한 편이다. 목소리 자체가 유니크하며 저음에서 특히 매력이 두드러진다. 고음 역시 진성, 가성 가리지 않고 시원하게 올리는 편이다."
    },
    {
      "name": "송윤형",
      "본명": "송윤형",
      "출생연도": "1995",
      "생년월일": "1995.02.08",
      "출신지": "",
      "역할": "서브보컬",
      "키": "",
      "MBTI": "ENFJ",
      "혈액형": "A",
      "info": "메인보컬인 김진환과 구준회가 비슷한 파트인 1절과 2절을 나눠 부른다면, 송윤형은 김동혁과 비슷한 파트를 나눠 부른다. 음색이 두드러지는 멤버들이 많아서 그렇지 이 쪽도 듣기 좋은 목소리를 갖고 있다."
    },
    {
      "name": "BOBBY",
      "본명": "김지원",
      "출생연도": "1995",
      "생년월일": "1995.12.21",
      "출신지": "",
      "역할": "메인래퍼",
      "키": "",
      "MBTI": "INTP",
      "혈액형": "O",
      "info": "톤이 중하이톤이며 아이돌 래퍼 뿐만 아니라 국힙이라고 불리는 대한민국 힙합에서 힙합의 유행을 이끌어 낼 정도로 매우 실력있는 래퍼이다."
    },
    {
      "name": "김동혁",
      "본명": "김동혁",
      "출생연도": "1997",
      "생년월일": "1997.01.03",
      "출신지": "",
      "역할": "메인댄서, 서브보컬",
      "키": "",
      "MBTI": "ENFP",
      "혈액형": "O",
      "info": "iKON 멤버들 중 미성이 가장 두드러진다. 하이톤의 목소리를 가져서 멤버들 역시 '멋있다'기보다는 '예쁘다'고 표현하는 듯. 서브보컬 중 파트가 가장 많다."
    },
    {
      "name": "구준회",
      "본명": "구준회",
      "출생연도": "1997",
      "생년월일": "1997.03.31",
      "출신지": "",
      "역할": "메인보컬",
      "키": "",
      "MBTI": "ENFP",
      "혈액형": "A",
      "info": "팀내에서 목소리가 가장 허스키하다. iKON 노래 특성상 보컬들이 많아 메인보컬 둘이서 중요 파트를 양분해야 하기 때문에 김진환과 비슷한 파트를 주로 맡는다."
    },
    {
      "name": "정찬우",
