  "members": [
    {
      "name": "한빈",
      "본명": "오한빈 (Ngô Hanbin)",
      "출생연도": "1998",
      "생년월일": "1998.01.19",
      "출신지": "베트남",
      "역할": "메인댄서, 보컬",
      "키": "",
      "MBTI": "ESFJ",
      "혈액형": "",
      "info": "베트남 국적의 멤버로, 메인댄서이자 리드보컬 포지션을 맡고 있다. 넓은 음역대와 정확한 발음으로 안정적인 댄스 라이브를 선보이며, K-POP 댄스 커버팀 창설 및 대회 우승 경력이 있다."
    },
    {
      "name": "형섭",
      "본명": "안형섭",
      "출생연도": "1999",
      "생년월일": "1999.08.09",
      "출신지": "대한민국",
      "역할": "보컬",
      "키": "",
      "MBTI": "INFJ",
      "혈액형": "",
      "info": "청량한 음색이 특징이며, 낮은 톤까지 소화 가능한 넓은 목소리 변화 폭을 가졌다. 프로듀스 101 시즌2 참가 시절부터 노력파로 유명하며 안정적인 댄스 실력과 다양한 표정 연기를 선보인다."
    },
    {
      "name": "혁",
      "본명": "구본혁",
      "출생연도": "2000",
      "생년월일": "2000.04.17",
      "출신지": "대한민국",
      "역할": "메인보컬",
      "키": "",
      "MBTI": "ISFP",
      "혈액형": "",
      "info": "메인보컬로서 팀의 음악적 색깔을 주도하며, 격렬한 안무 속에서도 저음, 중음, 고음을 안정적으로 소화하는 댄스 라이브 실력이 뛰어나다. 멤버들 중 동작이 정확하고 춤 습득력이 가장 빠르다."
    },
    {
      "name": "은찬",
      "본명": "최은찬",
      "출생연도": "2001",
      "생년월일": "2001.02.27",
      "출신지": "대한민국",
      "역할": "보컬",
      "키": "",
      "MBTI": "ISTJ",
      "혈액형": "",
      "info": "보컬라인 중 가장 허스키한 음색을 가지고 있어 중저음에 강점을 보이며, 큰 키와 피지컬을 이용한 시원시원한 춤선을 선보인다."
    },
    {
      "name": "LEW",
      "본명": "이의웅",
      "출생연도": "2001",
      "생년월일": "2001.04.05",
      "출신지": "대한민국",
      "역할": "리더, 메인래퍼, 보컬",
      "키": "",
      "MBTI": "ENTJ",
      "혈액형": "",
      "info": "리더이자 메인래퍼로 빠르고 정확한 딕션의 랩을 구사하며, 데뷔 앨범부터 타이틀곡과 수록곡 랩 메이킹을 담당한다. 허스키함과 미성이 공존하는 음색을 가졌다."
    },
    {
      "name": "태래",
      "본명": "김태래",
      "출생연도": "2002",
      "생년월일": "2002.05.09",
      "출신지": "대한민국",
      "역할": "래퍼",
      "키": "",
      "MBTI": "ISTJ",
      "혈액형": "",
      "info": "특유의 낮은 음색으로 로우톤의 랩을 구사하며 곡의 킬링파트 래핑으로 존재감을 드러낸다. 춤의 강약 조절과 포인트를 줄 수 있는 힘이 넘치는 제스처로 무대 위 지분을 챙긴다."
    }
