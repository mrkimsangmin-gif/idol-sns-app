  "info": {
    "멤버수": "5",
    "데뷔일": "2018.05.02",
    "소속사": "큐브엔터테인먼트",
    "그룹명뜻": "그룹명인 i-dle (아이들)은 각각의 개인을 아이(I)로 놓고, 여기에 한국어로 복수를 의미하는 복수 표시 접미사 -들 을 붙여 다섯 명의 개성이 모인 팀이라는 뜻이다. 아이들은 그동안 (여자)아이들, (G)I-DLE로 사용했던 그룹명에서 '여자' 'G'를 삭제했다. 이를 통해 아이들은 '여자' 혹은 그 어떤 성별로도 정의될 수 없는 그룹의 정체성을 재확립했다.",
    "팬덤명": "네버랜드",
    "응원봉": "네버봉 VER.3",
    "훈장": "서울가요대상 대상 (2024); 올해의 레코드 (2024)",
    "레이블": "88rising, 워너 뮤직 재팬",
    "유통사": "카카오엔터테인먼트, 워너 뮤직 재팬, 텐센트 뮤직 엔터테인먼트",
    "결성일": "2018.05.02",
    "활동유형": "걸그룹",
    "인스타그램": "",
    "유튜브": "",
    "X(트위터)": "",
    "틱톡": "",
    "멤버목록": "미연, 민니, 소연, 우기, 슈화"
  },
